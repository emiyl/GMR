#!/usr/bin/env bash
set -eu

ROOT="${WINEPREFIX:-$HOME/.gmrwine}"
MSVC_ROOT="${GMR_MSVC_ROOT:-$ROOT/drive_c/MSVC}"
SDK_ROOT="$ROOT/drive_c/Program Files (x86)/Windows Kits/10"

find_msvc_exe() {
    local exe_name="$1"

    find "$MSVC_ROOT/VC/Tools/MSVC" \
        -path "*/bin/Hostx64/x64/$exe_name" \
        2>/dev/null |
        sort |
        tail -n 1
}

CL_EXE="$(find_msvc_exe cl.exe)"

if [[ -z "$CL_EXE" ]]; then
    echo "Error: cl.exe was not found under $MSVC_ROOT." >&2
    exit 1
fi

# .../VC/Tools/MSVC/14.38.33130/bin/Hostx64/x64/cl.exe
MSVC_VERSION_DIR="$(dirname "$(dirname "$(dirname "$(dirname "$CL_EXE")")")")"

MSVC_INC="$MSVC_VERSION_DIR/include"
MSVC_LIB="$MSVC_VERSION_DIR/lib/x64"

if [[ ! -d "$MSVC_INC" ]]; then
    echo "Error: MSVC include directory not found:" >&2
    echo "  $MSVC_INC" >&2
    exit 1
fi

if [[ ! -d "$SDK_ROOT/Include" ]]; then
    echo "Error: Windows SDK not found:" >&2
    echo "  $SDK_ROOT" >&2
    exit 1
fi

# Find the SDK version without xargs, so spaces in the path are preserved.
SDK_VERSION=""

while IFS= read -r dir; do
    SDK_VERSION="$(basename "$dir")"
done < <(
    find "$SDK_ROOT/Include" \
        -mindepth 1 \
        -maxdepth 1 \
        -type d |
    sort -V
)

if [[ -z "$SDK_VERSION" ]]; then
    echo "Error: could not determine Windows SDK version." >&2
    exit 1
fi

SDK_INC="$SDK_ROOT/Include/$SDK_VERSION"
SDK_LIB="$SDK_ROOT/Lib/$SDK_VERSION"

echo "Using MSVC: $MSVC_VERSION_DIR" >&2
echo "Using Windows SDK: $SDK_VERSION" >&2

if [[ ! -f "$SDK_INC/ucrt/math.h" ]]; then
    echo "Error: UCRT math.h not found:" >&2
    echo "  $SDK_INC/ucrt/math.h" >&2
    exit 1
fi

# Convert paths to Windows paths.
MSVC_INC_WIN="$(winepath -w "$MSVC_INC")"
MSVC_LIB_WIN="$(winepath -w "$MSVC_LIB")"

SDK_INC_WIN="$(winepath -w "$SDK_INC")"
SDK_LIB_WIN="$(winepath -w "$SDK_LIB")"

# Equivalent to the relevant parts of vcvars64.bat.
export INCLUDE="${MSVC_INC_WIN};${SDK_INC_WIN}\\ucrt;${SDK_INC_WIN}\\shared;${SDK_INC_WIN}\\um;${SDK_INC_WIN}\\winrt"

export LIB="${MSVC_LIB_WIN};${SDK_LIB_WIN}\\ucrt\\x64;${SDK_LIB_WIN}\\um\\x64"

MSVC_BIN="$(dirname "$CL_EXE")"
export PATH="$MSVC_BIN:$PATH"

args=()

for arg in "$@"; do
    case "$arg" in
        /Fo/Users/*|/Fo/private/*)
            path="${arg#/Fo}"
            arg="/Fo$(winepath -w "$path")"
            ;;

        /Fd/Users/*|/Fd/private/*)
            path="${arg#/Fd}"
            arg="/Fd$(winepath -w "$path")"
            ;;

        /Users/*|/private/*)
            arg="$(winepath -w "$arg")"
            ;;
    esac

    args+=("$arg")
done

exec wine "$CL_EXE" "${args[@]}"