#!/bin/sh
set -eu

ROOT="${WINEPREFIX:-$HOME/.gmrwine}"
MSVC_ROOT="${GMR_MSVC_ROOT:-$ROOT/drive_c/MSVC}"

find_msvc_exe() {
    exe_name="$1"
    if [ -d "$MSVC_ROOT/VC/Tools/MSVC" ]; then
        find "$MSVC_ROOT/VC/Tools/MSVC" -path "*/bin/Hostx64/x64/$exe_name" 2>/dev/null | sort | tail -n 1
    fi
}

LIB_EXE="$(find_msvc_exe lib.exe)"
if [ -z "$LIB_EXE" ]; then
    echo "Error: lib.exe was not found under $MSVC_ROOT. Install the MSVC toolchain into the Wine prefix or set GMR_MSVC_ROOT." >&2
    exit 1
fi

exec wine "$LIB_EXE" "$@"